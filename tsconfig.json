{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Vercel transpiles each api/*.ts file individually (no bundling) and runs
       it through Node's native ESM loader, which requires explicit extensions
       on relative imports. "nodenext" mirrors that at typecheck time — it
       enforces (and TS will error on) writing e.g. './_lib/auth.js' instead
       of an extensionless or '.ts' specifier. */
    "module": "nodenext",
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
