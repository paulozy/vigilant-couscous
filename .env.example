# Copy this file to .env and fill in real values for local dev.
# In production (Vercel), set these under Project Settings → Environment
# Variables for Production + Preview + Development.
#
# Nothing here is client-exposed (VITE_*) anymore — the app no longer talks
# to Microsoft Graph/OAuth. ICS feed URLs live in the browser's localStorage,
# added through the app's own UI, not as env vars.

# The password/token required to log into the app.
# Generate with: openssl rand -base64 24
APP_PASSWORD=

# HMAC key used to sign/verify the 15-day session JWT.
# Generate with: openssl rand -base64 32
AUTH_SECRET=
