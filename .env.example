# Copy this file to .env and fill in real values for local dev.
# In production (Vercel), set these under Project Settings → Environment
# Variables for Production + Preview + Development.

# --- Client-exposed (safe: public Azure AD OAuth identifiers, not secrets) ---
# Ends up inlined in the client JS bundle — do NOT put real secrets here.
VITE_MS_CLIENT_ID=your-azure-app-client-id
VITE_MS_TENANT_ID=your-azure-tenant-id

# --- Server-only (never sent to the browser; NO VITE_ prefix) ---
# The password/token required to log into the app.
# Generate with: openssl rand -base64 24
APP_PASSWORD=

# HMAC key used to sign/verify the 15-day session JWT.
# Generate with: openssl rand -base64 32
AUTH_SECRET=
